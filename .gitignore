# Git ignore rules for Dotfiles Repository

# OS & Editor artifacts
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/

# Python caches and environments
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/

# Runtime and temp files
*.log
*.tmp
*.bak
.sentinel
copyq_tab_*.dat
copyq.lock
.copyq_s
copyq.pub

# Local application state
/gtk-3.0/bookmarks
/obs-studio/logs/
/obs-studio/profiler_data/
/obs-studio/plugin_config/obs-websocket/
/omarchy/current/background
/omarchy/current/theme/backgrounds/
/systemd/user/*.wants/
/systemd/user/rclone-gdrive.service
